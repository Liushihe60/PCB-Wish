{
  "$comment": "pcb-wish 设计 IR schema v0.1。设计先落成可离线校验的 IR（G1 门），校验通过才驱动 EDA。本 schema 由 scripts/ir/ir_validate.py 以手工结构检查实现（不依赖 jsonschema 包），两者字段须同步维护。",
  "type": "object",
  "required": ["meta", "stackup", "modules", "nets"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "created", "mission"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "mission": { "type": "string", "description": "相对项目根的 MISSION.md 路径" }
      }
    },
    "stackup": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "layers": { "type": "integer", "minimum": 1, "maximum": 4 },
        "plane_layers": { "type": "array", "items": { "type": "string" } },
        "impedance_targets": { "type": "array", "items": { "type": "object" } },
        "note": { "type": "string", "description": "叠层参数 API 读不到，阻抗结论只能标设计期规则满足" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "pins"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "description": "如 power/mcu/interface/sensing/protection" },
          "block_ref": { "type": "string", "description": "复用的电路块 id，须存在于 blocks/" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref", "value"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "value": { "type": "string" },
                "package": { "type": "string" },
                "part_number": { "type": "string" }
              }
            }
          },
          "pins": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$", "description": "格式 <元件位号>.<引脚名>" }
          },
          "boundary_ports": {
            "type": "array",
            "items": { "type": "object", "required": ["name", "net"], "properties": { "name": { "type": "string" }, "net": { "type": "string" } } }
          },
          "layout_constraints": { "type": "array", "items": { "type": "string" } },
          "teaching": { "type": "boolean", "description": "教学讲义是否为该模块出章" }
        }
      }
    },
    "nets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "members"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "clazz": { "type": "string", "description": "power/signal/analog/ground/diff" },
          "members": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$" } },
          "assertions": {
            "type": "array",
            "description": "派生的网表断言 id，供 netlist_assert.py",
            "items": { "type": "string" }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "h_ref", "statement"],
        "properties": {
          "id": { "type": "string" },
          "h_ref": { "type": "string", "pattern": "^H\\d+$", "description": "回链到 MISSION.md 硬约束编号" },
          "statement": { "type": "string" }
        }
      }
    },
    "teaching": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "profile": { "type": "string" }
      }
    }
  }
}
